# ==============================================================================
# Monzo Buffer Manager Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Financial Rules
# ------------------------------------------------------------------------------
# Target buffer balance to maintain on the main account (in cents, e.g., 10000 = €100.00)
TARGET_BUFFER_CENTS=10000

# Minimum threshold to recognize incoming transaction as salary (in cents, e.g., 150000 = €1500.00)
MIN_SALARY_AMOUNT_CENTS=150000


# ------------------------------------------------------------------------------
# Monzo API & Account Identifiers
# ------------------------------------------------------------------------------
# Your main Monzo Account ID (begins with acc_)
MONZO_ACCOUNT_ID=acc_0000XXXXXXXXXXXXXXXXXX

# OAuth2 Client ID from Monzo Developer Portal
MONZO_CLIENT_ID=oauth2client_0000XXXXXXXXXXXXXXXXXX

# OAuth2 Client Secret from Monzo Developer Portal
MONZO_CLIENT_SECRET=src_0000XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Pot ID used for auto-replenishment buffer (begins with pot_)
MONZO_ONGOING_POT_ID=pot_0000XXXXXXXXXXXXXXXXXX

# Pot ID used for salary savings/sweeping (begins with pot_)
MONZO_NZ_POT_ID=pot_0000XXXXXXXXXXXXXXXXXX

# Initial refresh token generated via OAuth authorization code flow.
# Used on the very first container boot to seed the SQLite database.
MONZO_INITIAL_REFRESH_TOKEN=ref_0000XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ------------------------------------------------------------------------------
# Telegram Bot Integration
# ------------------------------------------------------------------------------
# Bot token received from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Your personal Telegram user/chat ID to receive alerts and execute commands
TELEGRAM_CHAT_ID=123456789
